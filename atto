#!/usr/bin/env node
// attobrowser CLI. Raw CDP over WS.
//   atto start [port] [--kill]
//   atto stop
//   atto <Domain.method> [params-json]
const fs = require("fs");
const readline = require("readline");
const launch = require("./lib/launch-chrome");
const cdp = require("./lib/cdp");
const state = require("./lib/state");

const DEFAULT_PORT = 9229;
const METHOD = /^[A-Za-z]+\.[A-Za-z]+$/;

function getPort(explicit) {
  const port = Number(explicit ?? process.env.ATTOBROWSER_PORT ?? state.load()?.port ?? DEFAULT_PORT);
  if (!state.validPort(port)) throw new Error("port must be an integer from 1 to 65535");
  return port;
}

async function listTargets(port) {
  try {
    return await launch.listTargets(port, 2000);
  } catch {
    throw new Error(`Chrome not reachable on port ${port}. Run: atto start ${port}`);
  }
}

function findTarget(targets, targetId) {
  const target = targets.find((t) => t.type === "page" && t.id === targetId);
  if (!target) throw new Error(`Target ${targetId} missing. Run: atto tabs, then atto attach <targetId>`);
  return target;
}

function print(value) {
  console.log(JSON.stringify(value, null, 2));
}

async function send(client, method, params = {}) {
  if (typeof method !== "string" || !METHOD.test(method)) throw new Error("method must be Domain.method");
  const res = await client.send(method, params);
  if (res && typeof res === "object") {
    for (const [k, v] of Object.entries(res)) {
      if (typeof v === "string" && v.length > 4096 && /^[A-Za-z0-9+/=]+$/.test(v)) {
        const f = `/tmp/atto-${Date.now()}.${k === "data" ? "png" : "bin"}`;
        fs.writeFileSync(f, Buffer.from(v, "base64"));
        res[k] = f;
      }
    }
  }
  return res;
}

async function runSession(client, saved) {
  const lines = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
  console.log(JSON.stringify({ status: "connected", stateFile: state.statePath(), ...saved }));
  for await (const line of lines) {
    if (!line.trim()) continue;
    try {
      const { method, params } = JSON.parse(line);
      console.log(JSON.stringify({ result: await send(client, method, params) }));
    } catch (error) {
      console.log(JSON.stringify({ error: error.message }));
    }
  }
}

async function showState() {
  const saved = state.load();
  const result = { stateFile: state.statePath(), ...saved };
  if (!saved) return print({ ...result, status: "not attached" });
  let targets;
  try {
    targets = await listTargets(saved.port);
  } catch {
    return print({ ...result, status: "browser unreachable" });
  }
  const target = targets.find((t) => t.type === "page" && t.id === saved.targetId);
  print(target
    ? { ...result, status: "available", title: target.title, url: target.url }
    : { ...result, status: "target missing" });
}

async function main() {
  const args = process.argv.slice(2);
  const cmd = args[0];

  if (cmd === "start") {
    let port;
    let kill = false;
    for (const a of args.slice(1)) {
      if (/^\d+$/.test(a)) port = parseInt(a, 10);
      else if (a === "--kill" || a === "kill") kill = true;
    }
    const res = await launch.start({ port, kill });
    console.log(`port=${res.port} started=${res.started}`);
    return;
  }

  if (cmd === "stop") {
    await launch.stop();
    return;
  }

  if (cmd === "state") {
    if (args.length !== 1) throw new Error("usage: atto state");
    return showState();
  }

  if (cmd === "tabs") {
    if (args.length > 2) throw new Error("usage: atto tabs [port]");
    const targets = await listTargets(getPort(args[1]));
    return print(targets.filter((t) => t.type === "page").map(({ id, title, url }) => ({ id, title, url })));
  }

  if (cmd === "attach") {
    if (!args[1] || args.length > 3) throw new Error("usage: atto attach <targetId> [port]");
    const port = getPort(args[2]);
    const target = findTarget(await listTargets(port), args[1]);
    const client = await cdp.connect(target.webSocketDebuggerUrl);
    client.close();
    const saved = { port, targetId: target.id };
    state.save(saved);
    return print({ stateFile: state.statePath(), ...saved });
  }

  if (!cmd) {
    throw new Error("usage: atto start [port] [--kill] | stop | tabs [port] | attach <targetId> [port] | state | session | <Domain.method> [params-json]");
  }

  if (cmd === "session" ? args.length !== 1 : !METHOD.test(cmd) || args.length > 2) {
    throw new Error("usage: atto session | atto <Domain.method> [params-json]");
  }

  const params = args[1] ? JSON.parse(args[1]) : {};
  const saved = state.load();
  if (!saved) throw new Error(`No tab attached in ${state.statePath()}. Run: atto tabs, then atto attach <targetId>`);
  const target = findTarget(await listTargets(saved.port), saved.targetId);
  const client = await cdp.connect(target.webSocketDebuggerUrl);
  try {
    if (cmd === "session") await runSession(client, saved);
    else console.log(JSON.stringify(await send(client, cmd, params), null, 1));
  } finally {
    client.close();
  }
}

main().catch((e) => {
  console.error(e.message);
  process.exit(1);
});
