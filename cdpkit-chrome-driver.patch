+// Page-side DOM helpers. `pageHelpers` is serialized with `.toString()` and
+// evaluated inside the target page, so it must be self-contained: no closures
+// over Node scope, no `require`.
+
+function pageHelpers() {
+  const INTERACTIVE =
+    'a[href], button, input, select, textarea, summary, [role], [contenteditable=""], [contenteditable="true"], [tabindex]:not([tabindex="-1"]), [onclick]';
+  const CONTROLS =
+    'a[href], button, input, select, textarea, [contenteditable=""], [contenteditable="true"], [role="button"], [role="link"], [role="textbox"], [role="combobox"], [role="listbox"], [role="checkbox"], [role="radio"], [role="switch"], [role="tab"], [role="menuitem"], [role="option"], [role="slider"], [role="spinbutton"]';
+  const SKIP_ROLES = new Set([
+    "presentation",
+    "none",
+    "list",
+    "listbox",
+    "menu",
+    "menubar",
+    "radiogroup",
+    "group",
+    "tablist",
+    "toolbar",
+    "tree",
+    "grid",
+    "table",
+    "row",
+    "rowgroup",
+    "region",
+    "main",
+    "navigation",
+    "banner",
+    "contentinfo",
+    "complementary",
+    "form",
+    "dialog",
+    "alertdialog",
+    "alert",
+    "status",
+    "log",
+    "tooltip",
+    "img",
+    "heading",
+    "paragraph",
+    "separator",
+    "generic",
+    "document",
+    "application",
+    "article",
+  ]);
+  const TEXT_INPUT_TYPES = new Set([
+    "text",
+    "email",
+    "password",
+    "search",
+    "tel",
+    "url",
+    "number",
+    "date",
+    "datetime-local",
+    "month",
+    "week",
+    "time",
+  ]);
+
+  const refs = (window.__cdpkit = window.__cdpkit || { refs: {}, nextRef: 1 });
+
+  function norm(s) {
+    return (s || "").replace(/\s+/g, " ").trim();
+  }
+
+  function isVisible(el) {
+    if (!el || !(el instanceof Element)) return false;
+    if (el.closest('[aria-hidden="true"]')) return false;
+    if (typeof el.checkVisibility === "function") {
+      if (!el.checkVisibility({ checkOpacity: true, checkVisibilityCSS: true })) return false;
+    } else {
+      const cs = getComputedStyle(el);
+      if (cs.display === "none" || cs.visibility === "hidden" || cs.opacity === "0") return false;
+    }
+    const r = el.getBoundingClientRect();
+    if (r.width === 0 && r.height === 0) {
+      // Zero-size inputs (e.g. visually hidden checkboxes) may still have a clickable label.
+      return el.tagName === "INPUT" && !!el.labels && el.labels.length > 0;
+    }
+    return true;
+  }
+
+  function roleOf(el) {
+    const explicit = el.getAttribute("role");
+    if (explicit) return explicit.split(/\s+/)[0];
+    const tag = el.tagName;
+    if (tag === "A") return el.hasAttribute("href") ? "link" : "generic";
+    if (tag === "BUTTON" || tag === "SUMMARY") return "button";
+    if (tag === "SELECT") return el.multiple || el.size > 1 ? "listbox" : "combobox";
+    if (tag === "TEXTAREA") return "textbox";
+    if (tag === "OPTION") return "option";
+    if (tag === "INPUT") {
+      const t = (el.type || "text").toLowerCase();
+      if (t === "checkbox") return "checkbox";
+      if (t === "radio") return "radio";
+      if (t === "button" || t === "submit" || t === "reset" || t === "image") return "button";
+      if (t === "range") return "slider";
+      if (t === "file") return "button";
+      if (t === "hidden") return "hidden";
+      if (t === "search") return "searchbox";
+      return "textbox";
+    }
+    if (el.isContentEditable) return "textbox";
+    return "generic";
+  }
+
+  function textOf(el) {
+    return norm(el.innerText != null ? el.innerText : el.textContent);
+  }
+
+  function labelledBy(el) {
+    const ids = el.getAttribute("aria-labelledby");
+    if (!ids) return "";
+    return norm(
+      ids
+        .split(/\s+/)
+        .map((id) => {
+          const n = document.getElementById(id);
+          return n ? n.innerText || n.textContent : "";
+        })
+        .join(" ")
+    );
+  }
+
+  function nameOf(el) {
+    const aria = norm(el.getAttribute("aria-label"));
+    if (aria) return aria;
+    const lb = labelledBy(el);
+    if (lb) return lb;
+    if (el.labels && el.labels.length) {
+      const t = norm([...el.labels].map((l) => l.innerText || l.textContent).join(" "));
+      if (t) return t;
+    }
+    const wrappingLabel = el.closest("label");
+    if (wrappingLabel) {
+      const t = textOf(wrappingLabel);
+      if (t) return t;
+    }
+    const tag = el.tagName;
+    if (tag === "INPUT" || tag === "TEXTAREA") {
+      const ph = norm(el.getAttribute("placeholder"));
+      if (ph) return ph;
+      const t = (el.type || "").toLowerCase();
+      if ((t === "submit" || t === "button" || t === "reset") && el.value) return norm(el.value);
+    }
+    if (tag === "IMG") return norm(el.getAttribute("alt"));
+    const title = norm(el.getAttribute("title"));
+    const text = textOf(el);
+    if (text && text.length <= 200) return text;
+    if (title) return title;
+    if (text) return text.slice(0, 200);
+    const img = el.querySelector("img[alt]");
+    if (img) return norm(img.getAttribute("alt"));
+    return norm(el.getAttribute("name")) || norm(el.getAttribute("value"));
+  }
+
+  function cssEscape(s) {
+    return typeof CSS !== "undefined" && CSS.escape ? CSS.escape(s) : s.replace(/([^\w-])/g, "\\$1");
+  }
+
+  function unique(sel, el) {
+    try {
+      const found = document.querySelectorAll(sel);
+      return found.length === 1 && found[0] === el;
+    } catch {
+      return false;
+    }
+  }
+
+  function selectorFor(el) {
+    if (el.id && unique("#" + cssEscape(el.id), el)) return "#" + cssEscape(el.id);
+    const tag = el.tagName.toLowerCase();
+    for (const attr of ["name", "data-testid", "data-test", "data-id", "aria-label", "placeholder"]) {
+      const v = el.getAttribute(attr);
+      if (v) {
+        const sel = `${tag}[${attr}=${JSON.stringify(v)}]`;
+        if (unique(sel, el)) return sel;
+      }
+    }
+    const parts = [];
+    let cur = el;
+    while (cur && cur.nodeType === 1 && cur !== document.documentElement) {
+      let part = cur.tagName.toLowerCase();
+      if (cur.id && unique("#" + cssEscape(cur.id), cur)) {
+        parts.unshift("#" + cssEscape(cur.id));
+        break;
+      }
+      const parent = cur.parentElement;
+      if (parent) {
+        const sameTag = [...parent.children].filter((c) => c.tagName === cur.tagName);
+        if (sameTag.length > 1) part += `:nth-of-type(${sameTag.indexOf(cur) + 1})`;
+      }
+      parts.unshift(part);
+      cur = parent;
+    }
+    return parts.join(" > ");
+  }
+
+  function refFor(el) {
+    for (const [k, v] of Object.entries(refs.refs)) {
+      if (v === el) return k;
+    }
+    const id = "e" + refs.nextRef++;
+    refs.refs[id] = el;
+    return id;
+  }
+
+  function describe(el, opts) {
+    opts = opts || {};
+    const role = roleOf(el);
+    const tag = el.tagName.toLowerCase();
+    const r = el.getBoundingClientRect();
+    const d = {
+      ref: refFor(el),
+      role,
+      name: nameOf(el),
+      tag,
+      selector: selectorFor(el),
+    };
+    if (tag === "input") d.type = (el.type || "text").toLowerCase();
+    if (tag === "input" || tag === "textarea" || tag === "select") {
+      if (d.type !== "password") d.value = el.value;
+    } else if (el.isContentEditable) {
+      d.value = textOf(el).slice(0, 200);
+    }
+    if (role === "checkbox" || role === "radio" || role === "switch" || role === "menuitemcheckbox") {
+      const ac = el.getAttribute("aria-checked");
+      d.checked = ac != null ? ac === "true" : !!el.checked;
+    }
+    if (el.disabled || el.getAttribute("aria-disabled") === "true") d.disabled = true;
+    const exp = el.getAttribute("aria-expanded");
+    if (exp != null) d.expanded = exp === "true";
+    if (el.getAttribute("aria-invalid") === "true") d.invalid = true;
+    if (el.required || el.getAttribute("aria-required") === "true") d.required = true;
+    if (tag === "a" && el.href) d.href = el.href;
+    if (tag === "select") {
+      d.options = [...el.options].slice(0, 50).map((o) => o.text);
+    }
+    if (opts.rect) {
+      d.rect = { x: Math.round(r.x), y: Math.round(r.y), width: Math.round(r.width), height: Math.round(r.height) };
+    }
+    d.inViewport = r.bottom > 0 && r.right > 0 && r.top < innerHeight && r.left < innerWidth;
+    return d;
+  }
+
+  function candidates(root) {
+    root = root || document;
+    const out = [];
+    const seen = new Set();
+    for (const el of root.querySelectorAll(INTERACTIVE)) {
+      if (seen.has(el)) continue;
+      seen.add(el);
+      out.push(el);
+    }
+    return out;
+  }
+
+  function listInteractables(opts) {
+    opts = opts || {};
+    const limit = opts.limit || 200;
+    const out = [];
+    for (const el of candidates()) {
+      const role = roleOf(el);
+      if (role === "hidden" || SKIP_ROLES.has(role)) continue;
+      if (role === "generic" && !el.hasAttribute("tabindex") && !el.hasAttribute("onclick") && !el.isContentEditable) continue;
+      if (!opts.includeHidden && !isVisible(el)) continue;
+      out.push(describe(el, opts));
+      if (out.length >= limit) break;
+    }
+    return out;
+  }
+
+  function matchText(actual, wanted, exact) {
+    const a = norm(actual);
+    const w = norm(wanted);
+    if (!w) return true;
+    if (exact) return a === w;
+    return a.toLowerCase().includes(w.toLowerCase());
+  }
+
+  function resolveAll(locator) {
+    if (typeof locator === "string") {
+      if (locator.startsWith("@")) {
+        const el = refs.refs[locator.slice(1)];
+        if (!el) throw new Error(`stale or unknown ref ${locator}; call snapshot() again`);
+        if (!el.isConnected) throw new Error(`ref ${locator} is no longer in the document; call snapshot() again`);
+        return [el];
+      }
+      return [...document.querySelectorAll(locator)];
+    }
+    if (!locator || typeof locator !== "object") throw new Error("locator must be a selector string or object");
+    if (locator.ref) return resolveAll("@" + String(locator.ref).replace(/^@/, ""));
+    let els = locator.selector ? [...document.querySelectorAll(locator.selector)] : candidates();
+    if (locator.role) {
+      const roles = Array.isArray(locator.role) ? locator.role : [locator.role];
+      els = els.filter((el) => roles.includes(roleOf(el)));
+    }
+    if (locator.text != null) {
+      els = els.filter((el) => matchText(textOf(el), locator.text, locator.exact));
+      // Prefer the innermost matching elements so `text: "Next"` resolves to the button, not its container.
+      els = els.filter((el) => !els.some((other) => other !== el && el.contains(other)));
+    }
+    if (locator.label != null || locator.name != null) {
+      const wanted = locator.label != null ? locator.label : locator.name;
+      els = els.filter((el) => matchText(nameOf(el), wanted, locator.exact));
+    }
+    if (locator.placeholder != null) {
+      els = els.filter((el) => matchText(el.getAttribute("placeholder"), locator.placeholder, locator.exact));
+    }
+    if (locator.visible !== false) {
+      els = els.filter(isVisible);
+    }
+
+    return els;
+  }
+
+  function resolve(locator) {
+    const els = resolveAll(locator);
+    const index = typeof locator === "object" && locator && locator.index ? locator.index : 0;
+    if (!els.length) throw new Error(`element not found: ${JSON.stringify(locator)}`);
+    if (index >= els.length) {
+      throw new Error(`locator ${JSON.stringify(locator)} matched ${els.length} element(s); index ${index} out of range`);
+    }
+    return els[index];
+  }
+
+  function clickPoint(el) {
+    el.scrollIntoView({ block: "center", inline: "center" });
+    const r = el.getBoundingClientRect();
+    const x = r.left + r.width / 2;
+    const y = r.top + r.height / 2;
+    const hit = document.elementFromPoint(x, y);
+    const hitOk = !!hit && (hit === el || el.contains(hit) || hit.contains(el));
+    return { x, y, hit: hitOk, width: r.width, height: r.height };
+  }
+
+  function alerts() {
+    const out = [];
+    const seen = new Set();
+    // Assertive regions are reported as alerts; polite regions as status. Live regions that wrap
+    // controls (a labelled combobox, a language picker) are announcements of the control itself, not messages.
+    for (const el of document.querySelectorAll('[role="alert"], [aria-live="assertive"], [aria-live="polite"], [role="status"]')) {
+      const t = textOf(el);
+      if (!t || seen.has(t) || !isVisible(el)) continue;
+      if (el.matches(CONTROLS) || el.querySelector(CONTROLS)) continue;
+      seen.add(t);
+      const assertive = el.getAttribute("role") === "alert" || el.getAttribute("aria-live") === "assertive";
+      out.push({ kind: assertive ? "alert" : "status", text: t.slice(0, 300) });
+    }
+    let invalid = [...document.querySelectorAll('[aria-invalid="true"]')];
+    try {
+      invalid = invalid.concat([...document.querySelectorAll(":user-invalid")]);
+    } catch {
+      // :user-invalid unsupported
+    }
+    for (const el of invalid) {
+      if (!(el instanceof HTMLElement) || el.tagName === "FORM" || el.tagName === "FIELDSET") continue;
+      if (!isVisible(el)) continue;
+      let msg = "";
+      const desc = el.getAttribute("aria-describedby") || el.getAttribute("aria-errormessage");
+      if (desc) {
+        msg = norm(
+          desc
+            .split(/\s+/)
+            .map((id) => {
+              const n = document.getElementById(id);
+              return n ? n.innerText || n.textContent : "";
+            })
+            .join(" ")
+        );
+      }
+      if (!msg && el.validationMessage) msg = el.validationMessage;
+      const key = "invalid:" + selectorFor(el);
+      if (seen.has(key)) continue;
+      seen.add(key);
+      out.push({ kind: "invalid", field: nameOf(el), selector: selectorFor(el), text: msg.slice(0, 300) });
+    }
+    return out;
+  }
+
+  function installMutationTracker() {
+    if (window.__cdpkitMutation) return;
+    const state = { last: Date.now(), count: 0 };
+    const obs = new MutationObserver(() => {
+      state.last = Date.now();
