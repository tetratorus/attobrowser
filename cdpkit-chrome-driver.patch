+++ b/test/chrome.test.js
@@ -0,0 +1,140 @@
+// Integration tests for the Chrome driver. They attach to a Chrome instance
+// that already exposes CDP on CDPKIT_TEST_PORT (default 9229) and skip when
+// none is reachable. Run with: npm test
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const path = require("path");
+const fs = require("fs");
+const os = require("os");
+
+const chrome = require("../drivers/chrome");
+const session = require("../session");
+
+const port = parseInt(process.env.CDPKIT_TEST_PORT || "9229", 10);
+const fixture = `file://${path.join(__dirname, "fixtures", "form.html")}`;
+
+test("chrome driver", { concurrency: false }, async (t) => {
+  if (!(await session.reachable("127.0.0.1", port))) {
+    t.skip(`no CDP endpoint on 127.0.0.1:${port}; set CDPKIT_TEST_PORT`);
+    return;
+  }
+
+  const s = await chrome.start({ port });
+  await chrome.newTab(s, fixture);
+  const c = () => s.client;
+
+  t.after(async () => {
+    await chrome.closeTab(s);
+    await chrome.stop(s);
+  });
+
+  await t.test("navigate settles after late DOM mutations", async () => {
+    await chrome.navigate(c(), fixture);
+    assert.equal(await chrome.run(c(), "document.getElementById('mutating').textContent"), "late content");
+  });
+
+  await t.test("snapshot lists visible interactables with roles, names and refs", async () => {
+    const items = await chrome.snapshot(c());
+    const byName = Object.fromEntries(items.map((i) => [i.name, i]));
+    assert.equal(byName["First name"].role, "textbox");
+    assert.equal(byName["First name"].selector, "#first");
+    assert.equal(byName["Last name (optional)"].role, "textbox");
+    assert.equal(byName["I agree"].role, "checkbox");
+    assert.equal(byName["I agree"].checked, false);
+    assert.equal(byName["Colour"].role, "combobox");
+    assert.deepEqual(byName["Colour"].options, ["Pick", "Red", "Green"]);
+    assert.equal(byName["Next"].role, "button");
+    assert.equal(byName["Terms"].role, "link");
+    assert.ok(!byName["Hidden help"], "hidden link excluded");
+    assert.ok(!items.some((i) => i.role === "option"), "options of closed listbox excluded");
+    assert.ok(items.every((i) => /^e\d+$/.test(i.ref)));
+    const all = await chrome.snapshot(c(), { includeHidden: true });
+    assert.ok(all.some((i) => i.name === "Hidden help"));
+  });
+
+  await t.test("type uses trusted input events", async () => {
+    await chrome.type(c(), { label: "First name" }, "Ada");
+    assert.equal(await chrome.run(c(), "document.getElementById('typed').textContent"), "Ada");
+    await chrome.type(c(), "#first", "Grace");
+    assert.equal(await chrome.run(c(), "document.getElementById('first').value"), "Grace");
+    await chrome.type(c(), "#first", " Hopper", { clear: false });
+    assert.equal(await chrome.run(c(), "document.getElementById('first').value"), "Grace Hopper");
+    await chrome.type(c(), { placeholder: "Last name" }, "L");
+    assert.equal(await chrome.run(c(), "document.querySelector('[name=last]').value"), "L");
+  });
+
+  await t.test("click dispatches real pointer events, by text/role/ref", async () => {
+    const r1 = await chrome.click(c(), { text: "Counter", role: "button" });
+    assert.equal(r1.method, "mouse");
+    assert.equal(await chrome.run(c(), "document.getElementById('count').textContent"), "1");
+    const btn = await chrome.find(c(), { text: "Counter" });
+    await chrome.click(c(), `@${btn.ref}`);
+    assert.equal(await chrome.run(c(), "document.getElementById('count').textContent"), "2");
+    await chrome.click(c(), { label: "I agree" });
+    assert.equal(await chrome.run(c(), "document.querySelector('[name=agree]').checked"), true);
+  });
+
+  await t.test("click falls back to el.click() when covered", async () => {
+    await chrome.run(c(), "document.getElementById('overlay').style.display = 'block'");
+    const r = await chrome.click(c(), { label: "I agree" });
+    assert.equal(r.method, "js");
+    assert.equal(await chrome.run(c(), "document.querySelector('[name=agree]').checked"), false);
+    await chrome.run(c(), "document.getElementById('overlay').style.display = 'none'");
+  });
+
+  await t.test("select handles native <select> and ARIA combobox", async () => {
+    const native = await chrome.select(c(), { label: "Colour" }, "Green");
+    assert.deepEqual(native, { native: true, value: "g", text: "Green" });
+    assert.equal(await chrome.run(c(), "document.querySelector('[name=color]').value"), "g");
+    const custom = await chrome.select(c(), { role: "combobox", text: "Month" }, "March");
+    assert.equal(custom.native, false);
+    assert.equal(await chrome.run(c(), "document.getElementById('month').textContent"), "March");
+    assert.equal(await chrome.run(c(), "document.querySelector('[role=listbox]').hidden"), true);
+  });
+
+  await t.test("press sends keys; submit via Enter; alerts surface validation", async () => {
+    await chrome.press(c(), "Escape");
+    assert.equal(await chrome.run(c(), "document.getElementById('out').textContent"), "escaped");
+    await chrome.type(c(), "#first", "", { clear: true });
+    await chrome.click(c(), { text: "Next" });
+    const alerts = await chrome.getAlerts(c());
+    assert.ok(alerts.some((a) => a.kind === "alert" && a.text === "Enter a first name"));
+    assert.ok(alerts.some((a) => a.kind === "invalid" && a.field === "First name"));
+    await chrome.type(c(), "#first", "Ada", { submit: true });
+    await chrome.waitForText(c(), "submitted:Ada", { timeout: 3000 });
+    assert.deepEqual(await chrome.getAlerts(c()), []);
+  });
+
+  await t.test("locator errors are descriptive", async () => {
+    await assert.rejects(chrome.click(c(), { text: "No such button" }), /element not found/);
+    await assert.rejects(chrome.click(c(), "@e99999"), /stale or unknown ref/);
+    await assert.rejects(chrome.select(c(), { label: "Colour" }, "Purple"), /option not found/);
+  });
+
+  await t.test("getContext bundles url, text, interactables, alerts and screenshot", async () => {
+    const shot = path.join(os.tmpdir(), `cdpkit-test-${process.pid}.png`);
+    const ctx = await chrome.getContext(c(), { screenshotPath: shot });
+    assert.equal(ctx.url, fixture);
+    assert.equal(ctx.title, "cdpkit fixture");
+    assert.match(ctx.visibleText, /Fixture/);
+    assert.ok(ctx.interactables.length > 5);
+    assert.deepEqual(ctx.alerts, []);
+    assert.equal(ctx.screenshotPath, shot);
+    assert.ok(fs.statSync(shot).size > 1000);
+    fs.unlinkSync(shot);
+  });
+
+  await t.test("tabs: list, open, switch, close", async () => {
+    const before = await chrome.tabs(s);
+    const active = before.find((x) => x.active);
+    assert.equal(active.url, fixture);
+    await chrome.newTab(s, "about:blank");
+    assert.equal(await chrome.getUrl(s.client), "about:blank");
+    await chrome.switchTab(s, { url: "form.html" });
+    assert.equal(await chrome.getUrl(s.client), fixture);
+    const blank = (await chrome.tabs(s)).find((x) => x.url === "about:blank");
+    await chrome.closeTab(s, blank.id);
+    assert.ok(!(await chrome.tabs(s)).some((x) => x.id === blank.id));
+    assert.equal(await chrome.getUrl(s.client), fixture);
+  });
+});
