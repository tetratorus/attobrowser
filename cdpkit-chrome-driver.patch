 const os = require("os");
+const fs = require("fs");
+const path = require("path");
 
 const home = os.homedir();
 const chromeProfile = `${home}/.cdpkit-chrome`;
+const isMac = process.platform === "darwin";
+const isLinux = process.platform === "linux";
+
+const LINUX_CHROME_BINARIES = [
+  "google-chrome",
+  "google-chrome-stable",
+  "chromium",
+  "chromium-browser",
+  "chrome",
+];
+
+function findOnPath(names) {
+  const dirs = (process.env.PATH || "").split(path.delimiter).filter(Boolean);
+  for (const name of names) {
+    if (name.includes("/")) {
+      if (fs.existsSync(name)) return name;
+      continue;
+    }
+    for (const dir of dirs) {
+      const candidate = path.join(dir, name);
+      try {
+        fs.accessSync(candidate, fs.constants.X_OK);
+        return candidate;
+      } catch {
+        // keep looking
+      }
+    }
+  }
+  return null;
+}
+
+function chromeBinary() {
+  if (process.env.CDPKIT_CHROME) return process.env.CDPKIT_CHROME;
+  if (isMac) return "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
+  if (isLinux) return findOnPath(LINUX_CHROME_BINARIES);
+  return null;
+}
+
+const chromeArgs = (port) => [
+  `--user-data-dir=${chromeProfile}`,
+  `--remote-debugging-port=${port}`,
+  "--no-first-run",
+  "--no-default-browser-check",
+];
 
 const apps = {
   chrome: {
     name: "Google Chrome",
-    processName: "Google Chrome",
-    launchArgs: (port) => [
-      "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
-      `--user-data-dir=${chromeProfile}`,
-      `--remote-debugging-port=${port}`,
-      "--no-first-run",
-      "--no-default-browser-check",
-    ],
-    killCmd:
-      'killall -TERM "Google Chrome" 2>/dev/null; killall -TERM "Google Chrome Helper" 2>/dev/null; sleep 1; killall -9 "Google Chrome" 2>/dev/null; killall -9 "Google Chrome Helper" 2>/dev/null',
+    processName: isMac ? "Google Chrome" : undefined,
+    // Only match the cdpkit-owned profile so we never kill the user's own browser.
+    processPattern: isMac ? undefined : `--user-data-dir=${chromeProfile}`,
+    launchArgs: (port) => {
+      const bin = chromeBinary();
+      return bin ? [bin, ...chromeArgs(port)] : null;
+    },
+    killCmd: isMac
+      ? 'killall -TERM "Google Chrome" 2>/dev/null; killall -TERM "Google Chrome Helper" 2>/dev/null; sleep 1; killall -9 "Google Chrome" 2>/dev/null; killall -9 "Google Chrome Helper" 2>/dev/null'
+      : `pkill -TERM -f -- "--user-data-dir=${chromeProfile}" 2>/dev/null; sleep 1; pkill -9 -f -- "--user-data-dir=${chromeProfile}" 2>/dev/null`,
     defaultPort: 9229,
   },
   slack: {
     name: "Slack",
     processName: "Slack",
-    launchArgs: (port) => ["open", "-a", "Slack", "--args", `--remote-debugging-port=${port}`],
+    launchArgs: (port) => (isMac ? ["open", "-a", "Slack", "--args", `--remote-debugging-port=${port}`] : null),
     killCmd: 'killall -TERM Slack 2>/dev/null; killall -9 Slack 2>/dev/null',
     defaultPort: 9228,
   },
   notion: {
     name: "Notion",
     processName: "Notion",
-    launchArgs: (port) => ["open", "-a", "Notion", "--args", `--remote-debugging-port=${port}`],
+    launchArgs: (port) => (isMac ? ["open", "-a", "Notion", "--args", `--remote-debugging-port=${port}`] : null),
     killCmd:
       'killall -TERM Notion 2>/dev/null; killall -TERM "Notion Helper" 2>/dev/null; sleep 1; killall -9 Notion 2>/dev/null; killall -9 "Notion Helper" 2>/dev/null',
     defaultPort: 9230,
   },
 };
 
-module.exports = { apps };
