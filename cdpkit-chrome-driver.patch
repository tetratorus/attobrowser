+<!doctype html>
+<html>
+  <head>
+    <meta charset="utf-8" />
+    <title>cdpkit fixture</title>
+    <style>
+      .hidden { display: none; }
+      .listbox { border: 1px solid #999; }
+      .listbox[hidden] { display: none; }
+      #overlay { position: fixed; inset: 0; background: rgba(0,0,0,.3); display: none; }
+    </style>
+  </head>
+  <body>
+    <h1>Fixture</h1>
+    <form id="f" onsubmit="event.preventDefault(); document.getElementById('out').textContent = 'submitted:' + first.value;">
+      <label for="first">First name</label>
+      <input id="first" name="first" />
+      <input name="last" placeholder="Last name (optional)" />
+      <label><input type="checkbox" name="agree" /> I agree</label>
+      <select name="color" aria-label="Colour">
+        <option value="">Pick</option>
+        <option value="r">Red</option>
+        <option value="g">Green</option>
+      </select>
+      <div id="month-wrap">
+        <div id="month" role="combobox" aria-expanded="false" tabindex="0">Month</div>
+        <ul class="listbox" role="listbox" aria-label="Month" hidden>
+          <li role="option">January</li>
+          <li role="option">February</li>
+          <li role="option">March</li>
+        </ul>
+      </div>
+      <button type="submit">Next</button>
+      <button type="button" id="react-btn">Counter: <span id="count">0</span></button>
+      <a href="#help" class="hidden">Hidden help</a>
+      <a href="#terms">Terms</a>
+      <div role="alert" id="err" class="hidden">Enter a first name</div>
+    </form>
+    <p id="out"></p>
+    <p id="typed"></p>
+    <div id="overlay"></div>
+    <div id="mutating"></div>
+    <script>
+      // React-style controlled input: only trusts real input events
+      const first = document.getElementById("first");
+      let firstState = "";
+      first.addEventListener("input", (e) => {
+        if (e.isTrusted) firstState = first.value;
+        document.getElementById("typed").textContent = firstState;
+      });
+      // Button that only reacts to real pointer events
+      const btn = document.getElementById("react-btn");
+      btn.addEventListener("pointerup", (e) => {
+        if (!e.isTrusted) return;
+        const c = document.getElementById("count");
+        c.textContent = String(Number(c.textContent) + 1);
+      });
+      // Custom combobox
+      const month = document.getElementById("month");
+      const list = document.querySelector('[role="listbox"]');
+      month.addEventListener("click", () => {
+        const open = month.getAttribute("aria-expanded") === "true";
+        month.setAttribute("aria-expanded", String(!open));
+        list.hidden = open;
+      });
+      for (const li of list.querySelectorAll("li")) {
+        li.addEventListener("click", () => {
+          month.textContent = li.textContent;
+          month.setAttribute("aria-expanded", "false");
+          list.hidden = true;
+        });
+      }
+      document.getElementById("f").addEventListener("submit", () => {
+        const err = document.getElementById("err");
+        if (!first.value) {
+          err.classList.remove("hidden");
+          first.setAttribute("aria-invalid", "true");
+        } else {
+          err.classList.add("hidden");
+          first.removeAttribute("aria-invalid");
+        }
+      });
+      document.addEventListener("keydown", (e) => {
+        if (e.key === "Escape") document.getElementById("out").textContent = "escaped";
+      });
+      // Simulated async render after load: settle should wait for this
+      setTimeout(() => {
+        document.getElementById("mutating").textContent = "late content";
+      }, 300);
+    </script>
+  </body>
+</html>
